# Testlar uchun muhit. Haqiqiy sir YO'Q — repoda saqlanadi.
NODE_ENV=test
PORT=3100
LOG_LEVEL=error
# Ilova — production'dagi kabi `crm_app` roli (RLS qo'llanadi). Tenant
# tranzaksiyasiz ishlaydigan har bir yo'l testda darhol yiqiladi.
DATABASE_URL=postgresql://crm_app:crm_app@localhost:5433/crm_test?schema=public
# Migratsiya va test ma'lumotlarini tayyorlash — jadval egasi
DIRECT_DATABASE_URL=postgresql://crm:crm@localhost:5433/crm_test
CACHE_DRIVER=memory
# Faqat BullMQ integratsiya testi uchun (ilova testda `inline` navbat bilan)
REDIS_URL=redis://localhost:6380
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
WEB_ORIGINS=http://localhost:5173
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=crm-media-test
S3_BACKUP_BUCKET=crm-backup-test
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# Variantlar ishchisi testda qo'lda chaqiriladi (`processPending()`)
FILE_VARIANTS_INTERVAL_MS=0
SMS_PROVIDER=none
# Ishchi testda qo'lda chaqiriladi (`dispatch()`) — fonda aylanmaydi
SMS_DISPATCH_INTERVAL_MS=0
# Telegram: token YO'Q (bot o'chiq) — testlar soxta mijozni o'zi ulaydi; webhook sirini SOXTA
TELEGRAM_WEBHOOK_SECRET=test-telegram-webhook-secret-0123456789
# Webhook testlari uchun SOXTA kalitlar (haqiqiy emas)
PAYME_MERCHANT_ID=test-payme-merchant
PAYME_KEY=test-payme-key
CLICK_SERVICE_ID=1234
CLICK_MERCHANT_ID=5678
CLICK_SECRET_KEY=test-click-secret
OFD_ENABLED=false
# Fiskal ishchi intervali o'chiq — testlar navbatni o'zi aylantiradi
OFD_DISPATCH_INTERVAL_MS=0
