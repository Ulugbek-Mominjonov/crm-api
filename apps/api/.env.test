# Testlar uchun muhit. Haqiqiy sir YO'Q — repoda saqlanadi.
NODE_ENV=test
PORT=3100
LOG_LEVEL=error
DATABASE_URL=postgresql://crm:crm@localhost:5433/crm_test?schema=public
DIRECT_DATABASE_URL=postgresql://crm:crm@localhost:5433/crm_test
CACHE_DRIVER=memory
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
WEB_ORIGINS=http://localhost:5173
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=crm-media-test
S3_BACKUP_BUCKET=crm-backup-test
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
SMS_PROVIDER=none
OFD_ENABLED=false
PDF_ENABLED=false
