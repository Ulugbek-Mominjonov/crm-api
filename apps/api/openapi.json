{
  "openapi": "3.0.0",
  "paths": {
    "/health/live": {
      "get": {
        "description": "Hech qanday bog‘liqlikni tekshirmaydi. Orkestrator shu bo‘yicha konteynerni qayta ishga tushiradi — baza tushganda qayta ishga tushirish yordam bermaydi, shuning uchun u bu yerda tekshirilmaydi.",
        "operationId": "Health_live",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "status": "ok",
                    "uptimeSec": 42
                  }
                }
              }
            }
          }
        },
        "summary": "Jarayon tirikmi",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "description": "Baza va obyekt saqlagich tekshiriladi. Yuk balanslagich shu bo‘yicha trafik yuboradi.",
        "operationId": "Health_ready",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "status": "ok",
                    "uptimeSec": 42,
                    "checks": [
                      {
                        "name": "database",
                        "ok": true,
                        "ms": 3
                      }
                    ]
                  }
                }
              }
            }
          },
          "503": {
            "description": "Bog‘liqliklardan biri javob bermayapti"
          }
        },
        "summary": "Trafik qabul qilishga tayyormi",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "description": "Access token javobda, refresh token esa httpOnly cookie’da qaytadi. Bir email bir nechta do‘konda bo‘lsa AUTH_TENANT_REQUIRED qaytadi — so‘rovni `tenantId` bilan takrorlang.",
        "operationId": "Auth_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "AUTH_INVALID_CREDENTIALS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          },
          "409": {
            "description": "AUTH_TENANT_REQUIRED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          }
        },
        "summary": "Tizimga kirish",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "description": "Eski refresh token bekor qilinadi (rotatsiya). Bekor qilingan token qayta ishlatilsa barcha sessiyalar yopiladi.",
        "operationId": "Auth_refreshTokens",
        "parameters": [],
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "AUTH_INVALID_REFRESH | AUTH_TOKEN_REUSE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "refresh_token": []
          }
        ],
        "summary": "Access tokenni yangilash",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "Auth_logout",
        "parameters": [],
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "ok": true
                  }
                }
              }
            }
          }
        },
        "summary": "Joriy qurilmadan chiqish",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout-all": {
      "post": {
        "operationId": "Auth_logoutAll",
        "parameters": [],
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "revoked": 3
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Barcha qurilmalardan chiqish",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "Auth_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthUserDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Joriy foydalanuvchi",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/change-password": {
      "post": {
        "description": "Muvaffaqiyatli bo‘lsa BARCHA sessiyalar yopiladi.",
        "operationId": "Auth_changePassword",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "ok": true
                  }
                }
              }
            }
          },
          "401": {
            "description": "AUTH_INVALID_CREDENTIALS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Parolni o‘zgartirish",
        "tags": [
          "auth"
        ]
      }
    }
  },
  "info": {
    "title": "Qurilish CRM API",
    "description": "Qurilish mollari do‘koni uchun savdo, ombor va kassa tizimi. Barcha summalar — **butun so‘m**; miqdorlar — 3 kasr xonagacha.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "health",
      "description": "Sog‘liq va tayyorlik"
    },
    {
      "name": "auth",
      "description": "Autentifikatsiya"
    }
  ],
  "servers": [
    {
      "url": "http://localhost:3000/api/v1",
      "description": "Lokal"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "admin@crm.uz"
          },
          "password": {
            "type": "string",
            "example": "Qurilish2026!"
          },
          "tenantId": {
            "type": "string",
            "description": "Bitta email bir nechta do‘konda bo‘lsa, qaysi biriga kirish. Kerak bo‘lsa server AUTH_TENANT_REQUIRED xatosida ro‘yxatni beradi."
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "TenantSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "example": "Qurilish Mollari"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "AuthUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "example": "Bobur Toshmatov"
          },
          "email": {
            "type": "string",
            "example": "admin@crm.uz"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "manager",
              "sotuvchi",
              "omborchi"
            ]
          },
          "position": {
            "type": "string",
            "example": "Direktor"
          },
          "employeeId": {
            "type": "string"
          },
          "tenant": {
            "$ref": "#/components/schemas/TenantSummaryDto"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "role",
          "position",
          "employeeId",
          "tenant"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "number",
            "example": 900,
            "description": "Soniyada"
          },
          "user": {
            "$ref": "#/components/schemas/AuthUserDto"
          }
        },
        "required": [
          "accessToken",
          "expiresIn",
          "user"
        ]
      },
      "FieldErrorDto": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "example": "items[0].qty"
          },
          "code": {
            "type": "string",
            "example": "STOCK_INSUFFICIENT"
          },
          "meta": {
            "type": "object",
            "example": {
              "available": 12,
              "requested": 20
            }
          }
        },
        "required": [
          "code"
        ]
      },
      "ApiErrorDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "https://api.example.uz/errors/stock-insufficient"
          },
          "title": {
            "type": "string",
            "example": "Omborda yetarli tovar yo‘q"
          },
          "status": {
            "type": "number",
            "example": 422
          },
          "code": {
            "type": "string",
            "example": "STOCK_INSUFFICIENT"
          },
          "detail": {
            "type": "string",
            "example": "Sement M400: kerak 20, mavjud 12"
          },
          "instance": {
            "type": "string",
            "example": "/api/v1/sales"
          },
          "traceId": {
            "type": "string",
            "example": "01J9F3K8QW2M4X7Y"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldErrorDto"
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "instance",
          "traceId"
        ]
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string"
          },
          "newPassword": {
            "type": "string",
            "description": "Kamida 8 belgi; ommabop parollar rad etiladi"
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      }
    }
  }
}
