# ─────────────────────────────────────────────────────────────
# Qiymatlarsiz namuna. Nusxa oling: cp .env.example .env
# Barcha o'zgaruvchi ishga tushishda tekshiriladi (config/env.schema.ts).
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── Baza ──
DATABASE_URL=postgresql://crm:crm@localhost:5433/crm?schema=public
# Migratsiya uchun (pooler'siz). Berilmasa DATABASE_URL ishlatiladi.
DIRECT_DATABASE_URL=postgresql://crm:crm@localhost:5433/crm

# ── Kesh ── memory | redis | none
CACHE_DRIVER=memory
REDIS_URL=redis://localhost:6380

# ── Auth (RS256) ──
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# ── Transport ──
WEB_ORIGINS=http://localhost:5173

# ── Obyekt saqlagich (S3-mos) ──
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=crm-media-dev
S3_BACKUP_BUCKET=crm-backup-dev
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# ── Ixtiyoriy ──
SMS_PROVIDER=none
SMS_TOKEN=
OFD_ENABLED=false
OFD_ENDPOINT=
OFD_TOKEN=
PDF_ENABLED=false
SENTRY_DSN=
