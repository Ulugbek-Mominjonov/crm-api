# ─────────────────────────────────────────────────────────────
# Qiymatlarsiz namuna. Nusxa oling: cp .env.example .env
# Barcha o'zgaruvchi ishga tushishda tekshiriladi (config/env.schema.ts).
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── Baza ──
# Ilova ALOHIDA rol bilan ulanadi (`crm_app`, RLS qo'llanadi). Jadval egasi
# yoki superuser bilan ulanish RLS'ni chetlab o'tadi (03-security §3.5).
DATABASE_URL=postgresql://crm_app:crm_app@localhost:5433/crm?schema=public
# Migratsiya va seed uchun (pooler'siz, jadval egasi). Berilmasa DATABASE_URL.
DIRECT_DATABASE_URL=postgresql://crm:crm@localhost:5433/crm

# ── Kesh ── memory | redis | none
CACHE_DRIVER=memory
REDIS_URL=redis://localhost:6380
# Fon navbati: inline (jarayon ichida, Redis'siz) yoki bullmq (REDIS_URL bilan)
QUEUE_DRIVER=inline

# ── Auth (RS256) ──
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# ── Transport ──
WEB_ORIGINS=http://localhost:5173
# Oldidagi ishonchli proksilar soni (Caddy — 1). Lokalda proksisiz — 0
TRUST_PROXY=0

# ── Obyekt saqlagich (S3-mos) ──
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=crm-media-dev
S3_BACKUP_BUCKET=crm-backup-dev
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
# Rasm variantlari (128/512 WebP) ishchisi davri (ms), 0 — o'chiq
FILE_VARIANTS_INTERVAL_MS=10000

# ── Ixtiyoriy ──
SMS_PROVIDER=none
# eskiz — Bearer token; playmobile — login:parol
SMS_TOKEN=
SMS_SENDER=4546
# Bir do'kon uchun kunlik SMS chegarasi
SMS_DAILY_LIMIT=1000
# SMS navbati ishchisi davri (ms), 0 — o'chiq
SMS_DISPATCH_INTERVAL_MS=15000
# Obuna to'lovlari (bo'sh — o'chiq)
PAYME_MERCHANT_ID=
PAYME_KEY=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
# Fiskal chek (OFD): yoqilsa ENDPOINT va TOKEN majburiy
OFD_ENABLED=false
OFD_ENDPOINT=
OFD_TOKEN=
OFD_DISPATCH_INTERVAL_MS=30000
SENTRY_DSN=
# Sentry'da versiya (CI: git sha)
RELEASE=
