# ═══════════════════════════════════════════════════════════════════
# Egasi paneli sayti (T-135): alohida subdomen, o'sha API. Frontend build —
# /opt/www/owner (konteynerda /srv/owner), domen — /opt/edge/.env dagi OWNER_DOMAIN.
# Egasi API'si (`/api/v1/platform/*`) FAQAT shu domenda ochiq — crm.caddy da yopiq.
# Realtime (`/socket.io`) yo'q: egasi paneli WebSocket ishlatmaydi.
# ═══════════════════════════════════════════════════════════════════
{$OWNER_DOMAIN} {
	encode zstd gzip

	# Xohlasangiz faqat o'z IP'laringizdan: quyidagi ikki qatorni oching (vergul bilan ro'yxat)
	# @outsider not remote_ip 1.2.3.4 5.6.7.0/24
	# respond @outsider 403

	@backend {
		path /api/* /health/*
	}
	handle @backend {
		reverse_proxy crm-api:3000 {
			lb_try_duration 15s
			lb_try_interval 250ms
		}
	}

	handle /assets/* {
		root * /srv/owner
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv/owner
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# Qidiruv tizimlari indekslamasin
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	log {
		output file /data/logs/owner-access.log {
			roll_size 50mb
			roll_keep 5
		}
	}
}
