# ═══════════════════════════════════════════════════════════════════
# /opt/crm/backup.env (T-121, 11 §11.8) — REPODA EMAS, qiymatlar faqat serverda.
# backup.sh va verify-backup.sh o'qiydi (chmod 600).
# ═══════════════════════════════════════════════════════════════════

# Shifrlash: kalit juftligi serverdan TASHQARIDA yaratiladi — `age-keygen -o crm-backup.key`.
# Bu yerga faqat OCHIQ kalit (age1...); maxfiy kalit xavfsiz joyda (tiklash uchun shart)
AGE_PUBLIC_KEY=

# Cloudflare R2 (T-118)
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
BACKUP_BUCKET=crm-backup-prod
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# R2: region SDK uchun shart, lekin ishlatilmaydi
AWS_DEFAULT_REGION=auto
# Yangi aws-cli sukut bo'yicha qo'shadigan CRC32 checksum sarlavhalarini R2 qabul qilmasligi mumkin
AWS_REQUEST_CHECKSUM_CALCULATION=when_required
AWS_RESPONSE_CHECKSUM_VALIDATION=when_required
