# ═══════════════════════════════════════════════════════════════════
# Serverdagi /opt/crm/.env (11 §11.5) — REPODA EMAS. Qiymatlar bo'sh:
# sirlar faqat serverda. Ro'yxat — apps/api/src/config/env.schema.ts
# ═══════════════════════════════════════════════════════════════════
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
API_DOMAIN=api.domen.uz

# Ilova — `crm_app` (RLS qo'llanadi); migratsiya — jadval egasi `crm`
DATABASE_URL=postgresql://crm_app:PAROL@db:5432/crm?schema=public&connection_limit=10
DIRECT_DATABASE_URL=postgresql://crm:PAROL@db:5432/crm
REDIS_URL=redis://redis:6379
CACHE_DRIVER=memory
QUEUE_DRIVER=bullmq

JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

WEB_ORIGINS=https://crm.domen.uz
# API Caddy ortida (bitta hop): rate limit mijoz IP'si bo'yicha bo'lishi uchun SHART
TRUST_PROXY=1

# Cloudflare R2 (T-118, 11 §11.6) — `S3_FORCE_PATH_STYLE=true` R2 uchun majburiy
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=crm-media-prod
S3_BACKUP_BUCKET=crm-backup-prod
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
FILE_VARIANTS_INTERVAL_MS=10000

SMS_PROVIDER=none
SMS_TOKEN=
SMS_SENDER=4546
SMS_DAILY_LIMIT=1000
SMS_DISPATCH_INTERVAL_MS=15000

# Obuna to'lovlari (T-126)
PAYME_MERCHANT_ID=
PAYME_KEY=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# Fiskal chek (T-129): provayder tanlangach yoqiladi; token — faqat shu faylda
OFD_ENABLED=false
OFD_ENDPOINT=
OFD_TOKEN=
SENTRY_DSN=
